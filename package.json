{
  "name": "nicx-router-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm --filter @nicx/dashboard dev --host 127.0.0.1",
    "dev:worker": "pnpm --filter @nicx/worker dev",
    "test": "vitest run",
    "test:router": "python3 -m unittest discover -s tests/router -v",
    "test:database": "node tests/database/integration.test.mjs && node tests/database/schema.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @nicx/dashboard build && pnpm --filter @nicx/worker build",
    "estimate": "node --import tsx scripts/estimate.ts",
    "preflight": "node --import tsx scripts/preflight.mjs",
    "test:browser": "playwright test -c tests/browser/playwright.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.9",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
