#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled
    config_load nicx-telemetry
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    procd_open_instance
    procd_set_param command /usr/lib/nicx-telemetry/agent.sh
    procd_set_param respawn 3600 10 3
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_set_param term_timeout 10
    procd_set_param limits core=0
    procd_set_param nice 10
    procd_set_param file /etc/config/nicx-telemetry /etc/nicx-telemetry/token
    procd_close_instance
}
service_triggers() { procd_add_reload_trigger nicx-telemetry; }
reload_service() { stop;start; }
