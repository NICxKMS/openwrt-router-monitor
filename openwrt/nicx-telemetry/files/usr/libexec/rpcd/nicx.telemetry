#!/bin/sh
. "${NICX_LIB:-/usr/lib/nicx-telemetry}/common.sh"
. "${NICX_JSHN:-/usr/share/libubox/jshn.sh}"

reply_error() { json_init;json_add_boolean ok 0;json_add_string error "$1";json_dump; }
reply_ok() { json_init;json_add_boolean ok 1;json_dump; }
private_work() {
    init_state || return 1
    STATE=$(mktemp -d "$STATE/rpc.XXXXXX") || return 1
    trap 'rm -rf "$STATE"' EXIT
    trap 'exit 1' INT TERM
}
read_input() {
    init_state || return 1
    IFS= read -r input
    [ "${#input}" -le 8192 ] || return 1
    parse_json "$input"
}
case "$1" in
    list)
        echo '{"status":{},"test":{},"restart":{},"set_token":{"token":""},"snapshot":{"kind":""},"enroll":{"endpoint":"","enrollment_token":"","name":""}}'
        ;;
    call)
        case "$2" in
            status)
                if [ -r "$STATE/status.json" ] && [ -r "$STATE/lock/pid" ];then
                    read -r owner < "$STATE/lock/pid"
                    if number "$owner" && kill -0 "$owner" 2>/dev/null;then cat "$STATE/status.json";exit 0;fi
                fi
                json_init;json_add_boolean running 0
                json_add_boolean enrolled "$([ -s "$credential" ] && echo 1 || echo 0)"
                if [ -d "$STATE" ] && [ -s "$STATE/snapshot-status.json" ];then
                    status_tmp=$(mktemp "$STATE/rpc-status.XXXXXX") || exit 1
                    json_dump > "$status_tmp";attach_snapshot_status "$status_tmp";rm -f "$status_tmp"
                else json_dump;fi
                ;;
            restart)
                timeout 8 /etc/init.d/nicx-telemetry restart >/dev/null 2>&1
                if [ "$?" -eq 0 ];then reply_ok;else reply_error restart_failed;fi
                ;;
            test)
                load_config
                valid_endpoint "$endpoint" || { reply_error invalid_https_origin;exit 0; }
                private_work || { reply_error local_state_unavailable;exit 0; }
                make_curl_config "$STATE/auth" || { reply_error credential_missing_or_unsafe_permissions;exit 0; }
                code=$(https --request GET "$endpoint/api/v1/device/config")
                result=$?
                if [ "$result" -eq 0 ] && [ "$code" = 200 ];then reply_ok;else reply_error "connection_or_authentication_failed_$code";fi
                ;;
            set_token)
                read_input || { reply_error invalid_input;exit 0; }
                json_get_var token token
                export -n token;json_cleanup
                case "$token" in ''|*[!a-zA-Z0-9_-]*)reply_error invalid_device_credential;exit 0;;esac
                [ "${#token}" -ge 43 ] && [ "${#token}" -le 128 ] || { reply_error invalid_device_credential;exit 0; }
                [ -d "$CONFIG_DIR" ] && [ ! -L "$CONFIG_DIR" ] || { reply_error router_not_enrolled;exit 0; }
                credential_tmp=$(mktemp "$CONFIG_DIR/token.XXXXXX") || exit 1
                printf '%s\n' "$token" > "$credential_tmp";chmod 600 "$credential_tmp"
                mv -f "$credential_tmp" "$CONFIG_DIR/token"
                unset token input;json_cleanup
                reply_ok
                ;;
            enroll)
                read_input || { reply_error invalid_input;exit 0; }
                json_get_vars endpoint enrollment_token name
                valid_endpoint "$endpoint" || { reply_error invalid_https_origin;exit 0; }
                case "$enrollment_token" in ''|*[!a-zA-Z0-9_-]*)reply_error invalid_enrollment_token;exit 0;;esac
                [ "${#enrollment_token}" -ge 32 ] && [ "${#enrollment_token}" -le 128 ] && [ "${#name}" -ge 1 ] && [ "${#name}" -le 64 ] || { reply_error invalid_input;exit 0; }
                private_work || { reply_error local_state_unavailable;exit 0; }
                model=$(timeout 2 ubus call system board 2>/dev/null | head -c 8192 | jsonfilter -e '@.model' 2>/dev/null)
                json_init;json_add_string enrollment_token "$enrollment_token";json_add_string name "$name"
                if [ -n "$model" ] && [ "${#model}" -le 128 ];then json_add_string model "$model";fi
                json_dump > "$STATE/request"
                json_cleanup;unset enrollment_token input
                : > "$STATE/auth"
                code=$(https --request POST --data-binary "@$STATE/request" "$endpoint/api/v1/devices/enroll")
                result=$?;rm -f "$STATE/request"
                [ "$result" -eq 0 ] && { [ "$code" = 200 ] || [ "$code" = 201 ]; } || { reply_error enrollment_failed;exit 0; }
                parse_json "$(cat "$STATE/response")" || { reply_error invalid_enrollment_response;exit 0; }
                json_get_vars token device_id
                export -n token;json_cleanup
                valid_uuid "$device_id" || { reply_error invalid_device_id;exit 0; }
                case "$token" in ''|*[!a-zA-Z0-9_-]*)reply_error invalid_device_credential;exit 0;;esac
                [ "${#token}" -ge 43 ] && [ "${#token}" -le 128 ] || { reply_error invalid_device_credential;exit 0; }
                [ ! -L "$CONFIG_DIR" ] || { reply_error unsafe_credential_directory;exit 0; }
                mkdir -p "$CONFIG_DIR";chmod 700 "$CONFIG_DIR"
                # Never truncate a credential through a pre-existing symlink.
                credential_tmp=$(mktemp "$CONFIG_DIR/token.XXXXXX") || exit 1
                printf '%s\n' "$token" > "$credential_tmp";chmod 600 "$credential_tmp"
                mv -f "$credential_tmp" "$CONFIG_DIR/token"
                unset token
                if [ ! -e "$CONFIG_DIR/privacy-salt" ];then
                    salt_tmp=$(mktemp "$CONFIG_DIR/salt.XXXXXX") || exit 1
                    dd if=/dev/urandom bs=32 count=1 2>/dev/null | sha256sum | cut -d ' ' -f 1 > "$salt_tmp"
                    chmod 600 "$salt_tmp";mv "$salt_tmp" "$CONFIG_DIR/privacy-salt"
                fi
                uci set "nicx-telemetry.main.endpoint=$endpoint"
                uci set "nicx-telemetry.main.device_id=$device_id"
                uci commit nicx-telemetry
                restarted=0;restart_required=0
                if [ "$(uget enabled)" = 1 ];then
                    # Running agents cache the old identity. Stop their transport before using
                    # this credential under the new device ID, then discard old-account RAM data.
                    if timeout 8 /etc/init.d/nicx-telemetry restart >/dev/null 2>&1;then restarted=1;else restart_required=1;fi
                fi
                json_init;json_add_boolean ok 1;json_add_string device_id "$device_id"
                json_add_boolean restarted "$restarted";json_add_boolean restart_required "$restart_required";json_dump
                ;;
            snapshot)
                read_input || { reply_error invalid_input;exit 0; }
                json_get_var kind kind
                [ "$(uget diagnostics_enabled)" = 1 ] || { reply_error diagnostics_disabled;exit 0; }
                cloud_diag=$(jsonfilter -i "$STATE/status.json" -e '@.cloud_diagnostics_enabled' 2>/dev/null)
                case "$cloud_diag" in 1|true);;*)reply_error cloud_diagnostics_disabled;exit 0;;esac
                if ! mkdir "$STATE/snapshot.lock" 2>/dev/null;then reply_error snapshot_in_progress;exit 0;fi
                echo $$ > "$STATE/snapshot.lock/pid"
                trap 'rm -f "$STATE/snapshot.lock/pid";rmdir "$STATE/snapshot.lock" 2>/dev/null' EXIT
                active_snapshot=$(jsonfilter -i "$STATE/snapshot-status.json" -e '@.state' 2>/dev/null)
                case "$active_snapshot" in queued|uploading|retrying)reply_error snapshot_in_progress;exit 0;;esac
                case "$kind" in memory)source_file="$STATE/detail.json";;network)source_file="$STATE/network.json";;wifi)source_file="$STATE/wifi.json";;packages)
                    if command -v apk >/dev/null;then packages=$(timeout 3 apk info -v 2>/dev/null | head -c 8192)
                    elif command -v opkg >/dev/null;then packages=$(timeout 3 opkg list-installed 2>/dev/null | head -c 8192)
                    else reply_error package_inventory_unavailable;exit 0;fi
                    json_init;json_add_string installed_packages "$packages";json_dump > "$STATE/packages.json"
                    source_file="$STATE/packages.json";;*)reply_error unsupported_snapshot;exit 0;;esac
                [ -r "$source_file" ] || { reply_error snapshot_not_yet_available;exit 0; }
                [ "$(wc -c < "$source_file")" -le 12000 ] || { reply_error snapshot_too_large;exit 0; }
                # Only cached numeric/whitelisted collector outputs; no paths or commands from RPC input.
                snapshot_tmp=$(mktemp "$STATE/snapshot.XXXXXX") || exit 1
                read -r request_id < /proc/sys/kernel/random/uuid
                {
                    printf '{"request_id":"%s","kind":"%s","snapshot":' "$request_id" "$kind"
                    cat "$source_file";printf '}\n'
                } > "$snapshot_tmp"
                # Reject interrupted/corrupt cached JSON before it can invalidate a whole batch.
                if ! jshn -R "$snapshot_tmp" >/dev/null 2>&1;then
                    rm -f "$snapshot_tmp";reply_error snapshot_not_yet_available;exit 0
                fi
                snapshot_create "$request_id" "$kind"
                mv "$snapshot_tmp" "$STATE/snapshot"
                json_init;json_add_boolean ok 1;json_add_string request_id "$request_id";json_add_string kind "$kind";json_add_string state queued
                requested_uptime=$(jsonfilter -i "$STATE/snapshot-status.json" -e '@.requested_uptime_s' 2>/dev/null)
                json_add_double requested_uptime_s "$requested_uptime";json_dump
                ;;
            *)reply_error unsupported_method;;
        esac
        ;;
    *)exit 1;;
esac
