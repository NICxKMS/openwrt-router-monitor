# Browser-safe values only; create apps/dashboard/.env.local from these three.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_API_URL=
# For local separate Worker use http://localhost:8787 and matching APP_ORIGIN.

# Worker secrets: configure with Wrangler secret put, never VITE_ prefix.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
ADMIN_USER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_ID=
# Wrangler vars APP_ORIGIN must match browser origin exactly.
